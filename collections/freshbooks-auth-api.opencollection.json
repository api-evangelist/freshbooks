{
  "opencollection": "1.0.0",
  "info": {
    "name": "FreshBooks REST Auth API",
    "version": "2026-05-23"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
