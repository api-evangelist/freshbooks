            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.freshbooks.com/auth/api/v1/users/me"
          },
          "docs": "Identity of the authenticated user"
        }
      ]
    }
  ],
  "bundled": true
}